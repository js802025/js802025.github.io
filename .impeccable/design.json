  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Signage-white pill that lights amber on hover; the one button style.",
      "html": "<a class=\"ds-btn\" href=\"#\">Email me</a>",
      "css": ":host{--board:#0e0e10;--panel:#161618;--rule:#2b2b2f;--white:#f4f2ec;--dim:#a29d93;--amber:#ffb31a;--ink:#0e0e10;--d0:#241d10;--d1:#5c3f09;--d2:#9c6c10;--d3:#dc9814;--d4:#ffb31a;--l-calc:#3fbf4f;--l-sf:#ff5da2;--l-bus:#f2552c;--l-sk:#3a86ef;--l-bat:#1fb8b2;--l-doom:#5b50f5;--sign:'Overpass','Helvetica Neue',Arial,sans-serif;--dots:'Doto','Overpass Mono',monospace;--ease-out:cubic-bezier(.16,1,.3,1);} .ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.2em 1.3em 0;background:var(--white);color:var(--ink);font:600 1.0625rem/1 var(--sign);text-decoration:none;border-radius:999px;transition:background-color 200ms ease,transform 300ms var(--ease-out);} .ds-btn:hover{background:var(--amber);} .ds-btn:focus-visible{outline:2px solid var(--amber);outline-offset:3px;} .ds-btn:active{transform:scale(.97);transition-duration:80ms;}"
    },
    {
      "name": "Text Link",
      "kind": "custom",
      "description": "Inline white 600 link turning amber on hover.",
      "html": "<p class=\"ds-copy\">Source on <a class=\"ds-link\" href=\"#\">GitHub</a>.</p>",
      "css": ":host{--board:#0e0e10;--panel:#161618;--rule:#2b2b2f;--white:#f4f2ec;--dim:#a29d93;--amber:#ffb31a;--ink:#0e0e10;--d0:#241d10;--d1:#5c3f09;--d2:#9c6c10;--d3:#dc9814;--d4:#ffb31a;--l-calc:#3fbf4f;--l-sf:#ff5da2;--l-bus:#f2552c;--l-sk:#3a86ef;--l-bat:#1fb8b2;--l-doom:#5b50f5;--sign:'Overpass','Helvetica Neue',Arial,sans-serif;--dots:'Doto','Overpass Mono',monospace;--ease-out:cubic-bezier(.16,1,.3,1);} .ds-copy{background:var(--board);color:var(--dim);font:400 1.0625rem/1.5 var(--sign);padding:16px;} .ds-link{color:var(--white);font-weight:600;text-underline-offset:.2em;text-decoration-thickness:1px;} .ds-link:hover{color:var(--amber);} .ds-link:focus-visible{outline:2px solid var(--amber);outline-offset:3px;}"
    },
    {
      "name": "Top Strip",
      "kind": "nav",
      "description": "Sticky strip: wordmark, live LED Atlanta clock, dim nav.",
      "html": "<header class=\"ds-strip\"><a class=\"ds-word\" href=\"#\">Jack Adee</a><p class=\"ds-clock\">14:07 <small>ATL</small></p><nav class=\"ds-nav\"><a href=\"#\">Projects</a><a href=\"#\">Contact</a><a href=\"#\">GitHub</a></nav></header>",
      "css": ":host{--board:#0e0e10;--panel:#161618;--rule:#2b2b2f;--white:#f4f2ec;--dim:#a29d93;--amber:#ffb31a;--ink:#0e0e10;--d0:#241d10;--d1:#5c3f09;--d2:#9c6c10;--d3:#dc9814;--d4:#ffb31a;--l-calc:#3fbf4f;--l-sf:#ff5da2;--l-bus:#f2552c;--l-sk:#3a86ef;--l-bat:#1fb8b2;--l-doom:#5b50f5;--sign:'Overpass','Helvetica Neue',Arial,sans-serif;--dots:'Doto','Overpass Mono',monospace;--ease-out:cubic-bezier(.16,1,.3,1);} .ds-strip{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;padding:14px 24px;background:var(--board);border-bottom:1px solid var(--rule);font-family:var(--sign);color:var(--white);} .ds-word{font-weight:800;text-decoration:none;color:inherit;letter-spacing:-.01em;} .ds-clock{margin:0;font-family:var(--dots);font-weight:900;color:var(--amber);font-size:1.375rem;line-height:1;font-variant-numeric:tabular-nums;} .ds-clock small{font-size:.6em;color:var(--dim);font-family:var(--sign);font-weight:600;letter-spacing:.08em;} .ds-nav{justify-self:end;display:flex;gap:24px;} .ds-nav a{font-size:.875rem;font-weight:600;text-decoration:none;color:var(--dim);transition:color 160ms ease;} .ds-nav a:hover{color:var(--white);} .ds-nav a:focus-visible{outline:2px solid var(--amber);outline-offset:3px;}"
    },
    {
      "name": "Line Bullet",
      "kind": "chip",
      "refersTo": "line-bullet",
      "description": "Round bullet in the project's line colour with one board-black capital.",
      "html": "<span class=\"ds-bullets\"><span class=\"ds-bullet\" style=\"--line:#3fbf4f\">C</span><span class=\"ds-bullet\" style=\"--line:#ff5da2\">S</span><span class=\"ds-bullet\" style=\"--line:#f2552c\">G</span><span class=\"ds-bullet\" style=\"--line:#3a86ef\">K</span><span class=\"ds-bullet\" style=\"--line:#1fb8b2\">B</span><span class=\"ds-bullet\" style=\"--line:#5b50f5\">D</span></span>",
      "css": ":host{--board:#0e0e10;--panel:#161618;--rule:#2b2b2f;--white:#f4f2ec;--dim:#a29d93;--amber:#ffb31a;--ink:#0e0e10;--d0:#241d10;--d1:#5c3f09;--d2:#9c6c10;--d3:#dc9814;--d4:#ffb31a;--l-calc:#3fbf4f;--l-sf:#ff5da2;--l-bus:#f2552c;--l-sk:#3a86ef;--l-bat:#1fb8b2;--l-doom:#5b50f5;--sign:'Overpass','Helvetica Neue',Arial,sans-serif;--dots:'Doto','Overpass Mono',monospace;--ease-out:cubic-bezier(.16,1,.3,1);} .ds-bullets{display:flex;gap:12px;padding:16px;background:var(--board);} .ds-bullet{display:inline-grid;place-items:center;width:2em;height:2em;border-radius:50%;background:var(--line);color:var(--ink);font:800 1.0625rem/1 var(--sign);padding-top:.12em;transition:transform 300ms var(--ease-out);} .ds-bullet:hover{transform:scale(1.15);}"
    },
    {
      "name": "Departure Row",
      "kind": "card",
      "description": "Signature board row: bullet, name and kind, LED live figure, destination; slides right on hover.",
      "html": "<a class=\"ds-row\" href=\"#\" style=\"--line:#3fbf4f\"><span class=\"ds-b\">C</span><span class=\"ds-name\"><b>CalcMod</b><span>Calculator in Minecraft chat</span></span><span class=\"ds-status\">3.49M DL</span><span class=\"ds-to\">modrinth.com</span></a>",
      "css": ":host{--board:#0e0e10;--panel:#161618;--rule:#2b2b2f;--white:#f4f2ec;--dim:#a29d93;--amber:#ffb31a;--ink:#0e0e10;--d0:#241d10;--d1:#5c3f09;--d2:#9c6c10;--d3:#dc9814;--d4:#ffb31a;--l-calc:#3fbf4f;--l-sf:#ff5da2;--l-bus:#f2552c;--l-sk:#3a86ef;--l-bat:#1fb8b2;--l-doom:#5b50f5;--sign:'Overpass','Helvetica Neue',Arial,sans-serif;--dots:'Doto','Overpass Mono',monospace;--ease-out:cubic-bezier(.16,1,.3,1);} .ds-row{display:grid;grid-template-columns:auto 1fr 10rem 9rem;align-items:center;gap:24px;padding:18px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:var(--white);background:var(--board);font-family:var(--sign);transition:padding-left 400ms var(--ease-out);} .ds-row:hover,.ds-row:focus-visible{padding-left:12px;outline:none;} .ds-b{display:inline-grid;place-items:center;width:2em;height:2em;border-radius:50%;background:var(--line);color:var(--ink);font-weight:800;line-height:1;padding-top:.12em;} .ds-name{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 20px;} .ds-name b{font-weight:800;font-size:1.75rem;letter-spacing:-.02em;line-height:1.05;} .ds-name span{color:var(--dim);} .ds-status{font-family:var(--dots);font-weight:900;color:var(--amber);font-size:1.25rem;font-variant-numeric:tabular-nums;white-space:nowrap;} .ds-to{color:var(--dim);font-weight:600;} .ds-row:hover .ds-to{color:var(--white);}"
    },
    {
      "name": "LED Panel",
      "kind": "card",
      "refersTo": "led-panel",
      "description": "True-black panel with LED year, total, and a dot grid lit along the LED ramp.",
      "html": "<figure class=\"ds-panel\"><figcaption><span class=\"ds-year\">2026</span> <span class=\"ds-count\"><b>342</b> contributions</span></figcaption><div class=\"ds-grid\"><i></i><i class=\"l2\"></i><i class=\"l4\"></i><i class=\"l1\"></i><i></i><i class=\"l3\"></i><i class=\"l2\"></i><i class=\"l1\"></i><i class=\"l4\"></i><i></i><i class=\"l3\"></i><i class=\"l2\"></i><i></i><i class=\"l1\"></i></div></figure>",
      "css": ":host{--board:#0e0e10;--panel:#161618;--rule:#2b2b2f;--white:#f4f2ec;--dim:#a29d93;--amber:#ffb31a;--ink:#0e0e10;--d0:#241d10;--d1:#5c3f09;--d2:#9c6c10;--d3:#dc9814;--d4:#ffb31a;--l-calc:#3fbf4f;--l-sf:#ff5da2;--l-bus:#f2552c;--l-sk:#3a86ef;--l-bat:#1fb8b2;--l-doom:#5b50f5;--sign:'Overpass','Helvetica Neue',Arial,sans-serif;--dots:'Doto','Overpass Mono',monospace;--ease-out:cubic-bezier(.16,1,.3,1);} .ds-panel{margin:0;background:#000;border-radius:10px;padding:24px;display:grid;gap:20px;font-family:var(--sign);color:var(--dim);} .ds-year{font-family:var(--dots);font-weight:900;color:var(--amber);font-size:2.5rem;line-height:.8;} .ds-count b{font-family:var(--dots);font-weight:900;color:var(--amber);font-size:1.4em;} .ds-grid{display:grid;grid-template-rows:repeat(7,14px);grid-auto-flow:column;grid-auto-columns:14px;gap:4px;} .ds-grid i{border-radius:50%;background:var(--d0);transition:transform 200ms ease;} .ds-grid i:hover{transform:scale(1.5);} .ds-grid .l1{background:var(--d1);} .ds-grid .l2{background:var(--d2);} .ds-grid .l3{background:var(--d3);} .ds-grid .l4{background:var(--d4);}"
    },
    {
      "name": "Side Card",
      "kind": "card",
      "refersTo": "side-card",
      "description": "Panel card with a giant LED figure, caption, and pinned action.",
      "html": "<aside class=\"ds-side\"><p class=\"ds-fig\">3.49<span>M</span></p><p class=\"ds-cap\"><b>3,497,057</b> downloads on Modrinth.</p><a class=\"ds-btn\" href=\"#\">Get CalcMod</a></aside>",
      "css": ":host{--board:#0e0e10;--panel:#161618;--rule:#2b2b2f;--white:#f4f2ec;--dim:#a29d93;--amber:#ffb31a;--ink:#0e0e10;--d0:#241d10;--d1:#5c3f09;--d2:#9c6c10;--d3:#dc9814;--d4:#ffb31a;--l-calc:#3fbf4f;--l-sf:#ff5da2;--l-bus:#f2552c;--l-sk:#3a86ef;--l-bat:#1fb8b2;--l-doom:#5b50f5;--sign:'Overpass','Helvetica Neue',Arial,sans-serif;--dots:'Doto','Overpass Mono',monospace;--ease-out:cubic-bezier(.16,1,.3,1);} .ds-side{background:var(--panel);border-radius:10px;padding:28px;display:flex;flex-direction:column;gap:20px;color:var(--white);font:400 1.0625rem/1.5 var(--sign);max-width:360px;} .ds-fig{margin:0;font-family:var(--dots);font-weight:900;color:var(--amber);font-size:6rem;line-height:.8;letter-spacing:-.02em;display:flex;align-items:flex-start;font-variant-numeric:tabular-nums;} .ds-fig span{font-size:.45em;margin-left:.06em;} .ds-cap{margin:0;} .ds-cap b{font-weight:600;font-variant-numeric:tabular-nums;} .ds-btn{align-self:flex-start;display:inline-flex;align-items:center;min-height:48px;padding:.2em 1.3em 0;background:var(--white);color:var(--ink);font-weight:600;line-height:1;text-decoration:none;border-radius:999px;transition:background-color 200ms ease;} .ds-btn:hover{background:var(--amber);} .ds-btn:focus-visible{outline:2px solid var(--amber);outline-offset:3px;}"
    },
    {
      "name": "Strip Map Stop",
      "kind": "custom",
      "description": "A stop on the route: 48px bullet with its 6px line running down, headline and dim lead.",
      "html": "<div class=\"ds-stop\" style=\"--line:#f2552c\"><span class=\"ds-sb\">G</span><h3>GTBus</h3><p>Every Georgia Tech bus on one live map.</p></div>",
      "css": ":host{--board:#0e0e10;--panel:#161618;--rule:#2b2b2f;--white:#f4f2ec;--dim:#a29d93;--amber:#ffb31a;--ink:#0e0e10;--d0:#241d10;--d1:#5c3f09;--d2:#9c6c10;--d3:#dc9814;--d4:#ffb31a;--l-calc:#3fbf4f;--l-sf:#ff5da2;--l-bus:#f2552c;--l-sk:#3a86ef;--l-bat:#1fb8b2;--l-doom:#5b50f5;--sign:'Overpass','Helvetica Neue',Arial,sans-serif;--dots:'Doto','Overpass Mono',monospace;--ease-out:cubic-bezier(.16,1,.3,1);} .ds-stop{position:relative;padding:0 0 64px 72px;background:var(--board);color:var(--white);font-family:var(--sign);} .ds-stop::before{content:'';position:absolute;left:21px;top:24px;bottom:0;width:6px;background:var(--line);} .ds-sb{position:absolute;left:0;top:0;z-index:1;display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:var(--line);color:var(--ink);font-weight:800;font-size:1.375rem;padding-top:.12em;} .ds-stop h3{margin:0 0 12px;font-size:2.5rem;font-weight:800;letter-spacing:-.03em;line-height:1;} .ds-stop p{margin:0;color:var(--dim);font-size:1.375rem;line-height:1.35;max-width:28ch;}"
    }
  ],
  "narrative": {
    "northStar": "The Departures Board",
    "overview": "The home page is a transit departures board at night. Board black ground, signage-white grotesk names, and amber dot-matrix LEDs for every live figure. Each project is a scheduled line with its own transit colour, read in one glance as a row of the board, then ridden down as a strip map to its demo, terminating at Tech Tower. Nothing is decorative that a station would not carry: there are no glows, no gradients, and no ornamental greys.\n\nDensity is high at the board and generous everywhere else: rows are tight and tabular, sections breathe on a long section gap. Motion is signage motion. The board refreshes by cycling characters before they settle row by row, the contributions panel lights from unlit to full amber, and the closing photo arrives as LED dots that shrink and warm into true colour.",
    "keyCharacteristics": [
      "One dark ground, one white, one amber, two greys; colour beyond that belongs to a project's line.",
      "Live numbers are always LED: dot-matrix face, amber, tabular figures.",
      "One label grid for every project row: bullet, name and kind, live figure, destination.",
      "A project's line colour lives in its round bullet and its route stroke (the strip-map line and the 6px section top rule), nowhere else.",
      "Pill buttons in signage white that light amber on hover."
    ],
    "rules": [
      {
        "name": "The One Line Rule",
        "body": "Each project owns one line colour, set as `--line` on its row, section, or stop. It appears in the bullet and the route stroke only; two line colours never share a component.",
        "section": "colors"
      },
      {
        "name": "The Lit Means Live Rule",
        "body": "Amber is reserved for live data and interaction feedback. A static label is never amber.",
        "section": "colors"
      },
      {
        "name": "The Two Greys Rule",
        "body": "Dim and Rule are the only greys. Panel is a surface, not a text colour.",
        "section": "colors"
      },
      {
        "name": "The Signage Weight Rule",
        "body": "Headings are Overpass 800 with negative tracking (-0.01em to -0.035em); there are no light or italic display styles.",
        "section": "typography"
      },
      {
        "name": "The Dots Are Data Rule",
        "body": "Doto sets numbers and status only (`3.49M DL`, `LIVE`, `RUNNING`, the clock, the year). Never set names or sentences in it.",
        "section": "typography"
      },
      {
        "name": "The No Glow Rule",
        "body": "LEDs are lit by colour alone. No text-shadow, no blur halos, no gradients.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** give every new project one line colour and use it only in its bullet and route stroke.",
      "**Do** set every live number in Doto 900 amber with tabular figures.",
      "**Do** keep every project row on the same label grid: bullet, name and kind, live figure, destination.",
      "**Do** put lit content (dot grids, screens, LED figures) on true black (`led-black`) and raised wells on Panel.",
      "**Do** honour `prefers-reduced-motion`: settle text instantly, light the grid without stagger, show the photo without the dot resolve."
    ],
    "donts": [
      "**Don't** add glows, text shadows, or gradients to LEDs or anything else.",
      "**Don't** introduce a third grey or tint the white.",
      "**Don't** mix two line colours in one component, or use a line colour for body text.",
      "**Don't** set names or sentences in the dot-matrix face.",
      "**Don't** let SideFlick's Midnight Matinee tokens or the Minecraft chat colours appear outside their own sections.",
      "**Don't** use Georgia Tech gold and navy as a palette."
    ]
  }
}